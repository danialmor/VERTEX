# Solana wallet
WALLET_ADDRESS=                   # public key (e.g. 8HLF...)
WALLET_PRIVATE_KEY=               # base58 private key — used by Jupiter to sign swaps

# Trading APIs
OPENROUTER_API_KEY=               # from openrouter.ai/keys
JUPITER_API_KEY=                  # from jup.ag — optional, raises rate limits
RPC_URL=                          # Helius or other Solana RPC (e.g. https://mainnet.helius-rpc.com/?api-key=...)

# Telegram notifications & commands
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_CHAT_ID=                 # your Telegram user/chat ID

# Web terminal auth
AUTH_USERNAME=                    # login username
AUTH_PASSWORD_HASH=               # bcrypt hash — generate with: bun setup-auth.js
