<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>UniversalMspOptimizer</AssemblyName>
    <OutputPath>bin\$(Configuration)\net48\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Security"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="Microsoft.CSharp"/><Reference Include="System.Web.Extensions"/>
    <Reference Include="Extensibility" Condition="'$(UseMicrosoftVsInterop)' != 'true'"><HintPath>$(OfficePiaPath)\Extensibility.dll</HintPath><Private>false</Private><EmbedInteropTypes>true</EmbedInteropTypes></Reference>
    <Reference Include="Microsoft.VisualStudio.Interop" Condition="'$(UseMicrosoftVsInterop)' == 'true'"><HintPath>$(OfficePiaPath)\Microsoft.VisualStudio.Interop.dll</HintPath><Private>true</Private><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
    <Reference Include="office"><HintPath>$(OfficePiaPath)\office.dll</HintPath><Private>false</Private><EmbedInteropTypes>true</EmbedInteropTypes></Reference>
    <Reference Include="Microsoft.Office.Interop.MSProject"><HintPath>$(OfficePiaPath)\Microsoft.Office.Interop.MSProject.dll</HintPath><Private>false</Private><EmbedInteropTypes>true</EmbedInteropTypes></Reference>
    <Compile Include="*.cs"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
